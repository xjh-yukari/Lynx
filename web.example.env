# 示例不会自动加载；请按需要自行修改项目 .env，不要重复覆盖 DeepSeek 配置。
# 默认免 Key 搜索；免 Key 不代表当前网络一定可达。
WEB_SEARCH_ENABLED=true
WEB_SEARCH_PROVIDER=anysearch
WEB_SEARCH_MAX_RESULTS=5
WEB_SEARCH_TIMEOUT_SECONDS=10
# 不填写即可使用 AnySearch 匿名额度；不要把真实 Key 提交进 Git。
# ANYSEARCH_API_KEY=在此填写自己的密钥

WEB_FETCH_ENABLED=true
WEB_FETCH_TIMEOUT_SECONDS=15
WEB_FETCH_MAX_RESPONSE_BYTES=2097152
WEB_FETCH_MAX_CHARS=12000
WEB_FETCH_MAX_REDIRECTS=3

# 切换 Brave 时自行配置以下两项；不要把真实 Key 提交进 Git。
# WEB_SEARCH_PROVIDER=brave
# BRAVE_SEARCH_API_KEY=在此填写自己的密钥
